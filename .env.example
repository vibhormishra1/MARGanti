# M.A.R.G. — Environment Variables
# Copy this to .env in each service directory and fill in values.
# NEVER commit actual .env files — they are in .gitignore.

# ── Node Orchestrator (backend-node/.env) ──────────────────────────
NODE_PORT=4000
PYTHON_BASE_URL=http://localhost:8000
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ── Python AI Engine (backend-python/.env) ─────────────────────────
PYTHON_PORT=8000
GEMINI_API_KEY=your_gemini_api_key_here

# ── React Frontend (frontend/.env) ─────────────────────────────────
# Vite requires VITE_ prefix to expose vars to the browser
VITE_NODE_BASE_URL=http://localhost:4000
VITE_GOOGLE_MAPS_KEY=your_google_maps_api_key_here
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
