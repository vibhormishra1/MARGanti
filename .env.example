# M.A.R.G. v2 — Environment Variables
# Copy to .env in the repository root and fill in values.
# NEVER commit actual .env files — they are in .gitignore.

# ── General ─────────────────────────────────────────────────────────
# development | testing | staging | production
ENVIRONMENT=development

# ── FastAPI Backend (apps/api) ──────────────────────────────────────
API_PORT=8000

# PostgreSQL (Supabase or standalone)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication — MUST be changed for production/staging
JWT_SECRET_KEY=super-secret-key-for-local-dev-only

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# ── Next.js Frontend (apps/web) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
